<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal rediseñada (Punto 1) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado con saludo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_encabezado"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSaludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_extrabold"
                    android:textColor="@color/blanco"
                    android:textSize="22sp"
                    tools:text="Hola, Wilderman" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/inicio_lema"
                    android:textColor="@color/blanco"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/fondo_redondeado"
                android:contentDescription="@string/desc_logo"
                android:padding="6dp"
                android:src="@drawable/marca_huellitas" />
        </LinearLayout>

        <!-- Acceso visible a urgencias -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUrgencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/urgencia_suave"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_urgencia"
                    app:tint="@color/urgencia" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="@string/inicio_urgencia_titulo"
                        android:textColor="@color/urgencia"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inicio_urgencia_texto"
                        android:textColor="@color/texto_principal"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_siguiente"
                    app:tint="@color/urgencia" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cuidados con alarma: próximo pendiente -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCuidados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/verde_suave"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alarma"
                    app:tint="@color/verde" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="@string/inicio_cuidados_titulo"
                        android:textColor="@color/verde"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvCuidadosResumen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inicio_cuidados_vacio"
                        android:textColor="@color/texto_principal"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCuidadosVencidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/urgencia"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="2 pendiente(s) por registrar"
                        tools:visibility="visible" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_siguiente"
                    app:tint="@color/verde" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Accesos rápidos a los módulos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/inicio_modulos"
            android:textAppearance="@style/Texto.Subtitulo" />

        <GridLayout
            android:id="@+id/gridAccesos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="3"
            android:useDefaultMargins="false" />

        <!-- Perros registrados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mis_perros"
                android:textAppearance="@style/Texto.Subtitulo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarPerro"
                style="@style/Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/agregar"
                app:icon="@drawable/ic_mas" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSinPerros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_redondeado"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/sin_perros"
            android:textAppearance="@style/Texto.Cuerpo"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPerros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
