<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de lista genérica: ícono o inicial, título, subtítulo, dato a la derecha -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/ivIcono"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_redondeado"
                android:backgroundTint="@color/verde_suave"
                android:contentDescription="@null"
                android:padding="10dp"
                app:tint="@color/verde"
                tools:src="@drawable/ic_pedidos" />

            <TextView
                android:id="@+id/tvInicial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_redondeado"
                android:backgroundTint="@color/azul_suave"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:textColor="@color/azul"
                android:textSize="20sp"
                android:visibility="gone"
                tools:text="J" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Texto.Subtitulo"
                android:textSize="15sp"
                tools:text="Pedido 8F3A2B1C" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/Texto.Cuerpo"
                android:textSize="13sp"
                tools:text="21 oct 2026 · 3 unidades" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDerecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="$ 120.300" />

            <TextView
                android:id="@+id/tvEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/fondo_redondeado"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Pagado"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
