<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja de mensaje (chat con IA y chat entre usuarios) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top"
        android:layout_marginEnd="6dp"
        android:contentDescription="@null"
        android:src="@drawable/marca_huellitas"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/burbuja"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/burbuja_otro"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvRemitente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/azul"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Jeferson"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/texto_principal"
            android:textIsSelectable="true"
            android:textSize="15sp"
            tools:text="Hola, ¿cada cuánto debo bañar a mi perro?" />

        <TextView
            android:id="@+id/tvHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_secundario"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="7:45 p. m."
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
