<?xml version="1.0" encoding="utf-8"?>
<!-- Intro animada: reproduce el video del logotipo HuellitasPlus -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_intro"
    tools:context=".ui.inicio.IntroActivity">

    <VideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOmitir"
        style="@style/Boton.Texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="@string/omitir"
        android:textColor="@color/noche"
        android:visibility="invisible" />

</FrameLayout>
